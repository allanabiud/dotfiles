// ============================================
// DMS Configurations
// ============================================
include "dms/outputs.kdl"
include "dms/cursor.kdl"

// DMS input settings (mouse/touchpad accel, etc.). Seeded by chezmoi like the
// files above, so it's a plain include. custom/inputs.kdl comes later and
// replaces whole sections, which is where our own input preferences win.
include "dms/input.kdl"

include "dms/colors.kdl"
include "dms/layout.kdl"

// DMS owns these three (they're in .chezmoiignore and DMS rewrites them).
// optional=true so that a freshly-bootstrapped system still loads this config
// before DMS has deployed them; niri watches the paths either way and picks
// them up as soon as they appear.
include optional=true "dms/binds.kdl"
include optional=true "dms/alttab.kdl"

include "dms/wpblur.kdl"
include optional=true "dms/windowrules.kdl"

// ============================================
// Custom Overrides
// ============================================
include "custom/startup.kdl"
include "custom/inputs.kdl"
include "custom/layout.kdl"
include "custom/misc.kdl"
include "custom/rules.kdl"

// User keybinds — must remain after the DMS includes above: niri lets the
// last definition of a key win, so this is what overrides DMS defaults.
include "custom/binds.kdl"
