#!/usr/bin/env bash
#
# sync_music.sh — one-way rsync mirror of the local music library to the
# SMB server at smb://192.168.0.29/DATA/MEDIA/Music/Music-Library
#
# The share is mounted on demand via the fstab "noauto" entry at
# /mnt/music-library (credentials in /etc/samba/music-lib.creds).
#
# Syncthing is NOT touched by this script — it continues to sync the
# library to mobile devices independently.
#
set -Eeuo pipefail

# Perdoo-style terminal output: colors are disabled when stdout/stderr is not a TTY.
if [[ -t 1 ]]; then
    BOLD=$'\033[1m'
    BLUE=$'\033[34m'
    GREEN=$'\033[32m'
    YELLOW=$'\033[33m'
    RED=$'\033[31m'
    RESET=$'\033[0m'
else
    BOLD=''
    BLUE=''
    GREEN=''
    YELLOW=''
    RED=''
    RESET=''
fi

# --- Configuration ----------------------------------------------------------
SERVER_IP="192.168.0.29"
MNT="/mnt/music-library"
SRC="${HOME}/Music/Music-Library/"
# The fstab entry mounts the library folder itself, so the mount root IS the
# destination directory (contains Backups/, Music/, To-Sort/, ...).
DST="${MNT}/"
# ---------------------------------------------------------------------------

DRY_RUN=0
UNMOUNT=0

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

One-way rsync mirror of ~/Music/Music-Library to ${SERVER_IP} (SMB).

Options:
  -n, --dry-run   Preview changes without modifying the server copy
  -u, --unmount   Unmount the share after a successful sync
  -h, --help      Show this help

Local library is the source of truth: files removed locally are removed
on the server (--delete).
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run) DRY_RUN=1 ;;
        -u|--unmount) UNMOUNT=1 ;;
        -h|--help)    usage; exit 0 ;;
        *) echo "error: unknown option '$1'" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

log_info()    { printf '%s==>%s %s%s%s\n' "$BLUE" "$RESET" "$BOLD" "$1" "$RESET"; }
log_success() { printf '%s==>%s %s%s%s\n' "$GREEN" "$RESET" "$BOLD" "$1" "$RESET"; }
log_warn()    { printf '%sWARNING:%s %s\n' "$YELLOW" "$RESET" "$1" >&2; }
fail()        { printf '%sERROR:%s %s\n' "$RED" "$RESET" "$1" >&2; exit 1; }

trap 'fail "unexpected failure at line $LINENO"' ERR

# --- 1. Preflight: is the server reachable? ---------------------------------
command -v rsync >/dev/null 2>&1 || fail "rsync is not installed"
command -v mountpoint >/dev/null 2>&1 || fail "mountpoint is not installed"
[ -d "$SRC" ] || fail "source library does not exist: $SRC"

log_info "Checking SMB connectivity to ${SERVER_IP}:445..."
if ! timeout 3 bash -c "exec 3<>/dev/tcp/${SERVER_IP}/445" 2>/dev/null; then
    fail "server ${SERVER_IP} unreachable (SMB port 445 closed) — is it powered on?"
fi
log_success "SMB server is reachable."

# --- 2. Auto-mount the share ------------------------------------------------
if mountpoint -q "$MNT"; then
    log_info "Using mounted share: $MNT"
else
    log_info "Mounting $MNT..."
    sudo mount "$MNT" || fail "could not mount $MNT — check the fstab entry and /etc/samba/music-lib.creds"
    log_success "Share mounted."
fi

# --- 3. Verify destination --------------------------------------------------
[ -d "$DST" ] || fail "destination not found on share: $DST"

# --- 4. Run rsync -----------------------------------------------------------
RSYNC_OPTS=(
    -rlt                    # recursive, keep symlinks, keep times
    --human-readable
    --partial               # resume interrupted transfers
    --delete                # mirror deletions from local to server
    --info=progress2        # overall progress bar
    --stats                 # summary at the end
    # Syncthing bookkeeping stays local (it still syncs to mobile devices):
    --exclude='.stfolder/'
    --exclude='.stignore'
    --exclude='.stversions/'
)
[ "$DRY_RUN" -eq 1 ] && RSYNC_OPTS+=(-n)

printf '\n'
if [ "$DRY_RUN" -eq 1 ]; then
    log_info "DRY RUN — no changes will be made."
else
    log_info "Synchronizing music library..."
fi
printf '  %sfrom:%s %s\n' "$BOLD" "$RESET" "$SRC"
printf '  %sto:%s   %s\n\n' "$BOLD" "$RESET" "$DST"

set +e
rsync "${RSYNC_OPTS[@]}" "$SRC" "$DST"
rc=$?
set -e

# rsync exit codes: 0 = ok, 24 = source files vanished mid-transfer (warning)
if [ "$rc" -eq 24 ]; then
    log_warn "some source files vanished during the transfer (24); likely caused by concurrent moves"
elif [ "$rc" -ne 0 ]; then
    fail "rsync failed with exit code $rc"
fi

# --- 5. Optionally unmount --------------------------------------------------
if [ "$UNMOUNT" -eq 1 ] && mountpoint -q "$MNT"; then
    printf '\n'
    log_info "Unmounting $MNT..."
    sudo umount "$MNT" || fail "could not unmount $MNT (is it busy?)"
    log_success "Share unmounted."
fi

printf '\n'
log_success "Music library sync complete."
