#!/usr/bin/env bash
# ==============================================================================
# Arch Linux System Maintenance & Cleanup Script
# Tailored for lightweight, performant setups.
# ==============================================================================

set -uo pipefail

# Colors for output
BOLD="\033[1m"
GREEN="\033[1;32m"
BLUE="\033[1;34m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

log_info()    { printf "${BLUE}==>${RESET} ${BOLD}%s${RESET}\n" "$1"; }
log_success() { printf "${GREEN}==>${RESET} ${BOLD}%s${RESET}\n" "$1"; }
log_warn()    { printf "${YELLOW}WARNING:${RESET} %s\n" "$1"; }
log_error()   { printf "${RED}ERROR:${RESET} %s\n" "$1"; }

print_header() {
  printf "\n${BOLD}%s${RESET}\n" "$1"
  printf '%*s\n' "${#1}" '' | tr ' ' '='
}

# Ensure sudo is authenticated early if needed
check_sudo() {
  if ! sudo -v; then
    log_error "Sudo authorization required."
    exit 1
  fi
}

disk_free_human() {
  df -h / | awk 'NR==2 {print $4}'
}

# ------------------------------------------------------------------------------
# 1. Systemd Failed Services Check
# ------------------------------------------------------------------------------
check_failed_services() {
  print_header "1. Checking for Failed Systemd Services"
  
  local failed_sys failed_user
  failed_sys=$(systemctl --failed --quiet --lines=0)
  failed_user=$(systemctl --user --failed --quiet --lines=0)

  if [ -z "$failed_sys" ] && [ -z "$failed_user" ]; then
    log_success "No failed system or user services found."
  else
    if [ -n "$failed_sys" ]; then
      log_warn "Failed system services:"
      systemctl --failed --lines=0
    fi
    if [ -n "$failed_user" ]; then
      log_warn "Failed user services:"
      systemctl --user --failed --lines=0
    fi
  fi
}

# ------------------------------------------------------------------------------
# 2. Pacman & AUR Cache Cleanup
# ------------------------------------------------------------------------------
clean_package_cache() {
  print_header "2. Cleaning Package Caches"

  if command -v paccache &>/dev/null; then
    log_info "Keeping the 2 most recent versions of installed packages..."
    sudo paccache -rk2 || true

    log_info "Removing all cached versions of uninstalled packages..."
    sudo paccache -ruk0 || true
  else
    log_warn "paccache not found. Falling back to pacman -Sc."
    sudo pacman -Sc --noconfirm || true
  fi

  # Yay cache cleanup
  if command -v yay &>/dev/null; then
    if [ -d "$HOME/.cache/yay" ]; then
      log_info "Cleaning yay build and repo caches..."
      yay -Sc --noconfirm || true
    fi
  fi
}

# ------------------------------------------------------------------------------
# 3. Orphan Package Removal
# ------------------------------------------------------------------------------
remove_orphans() {
  print_header "3. Checking for Orphaned Packages"

  local orphans
  orphans=$(pacman -Qtdq 2>/dev/null || true)

  if [ -n "$orphans" ]; then
    echo "Found the following unused dependencies:"
    echo "$orphans"
    read -rp "Do you want to remove these packages? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      sudo pacman -Rns $orphans
      log_success "Orphaned packages removed."
    else
      log_info "Skipping orphan removal."
    fi
  else
    log_success "No orphaned packages found."
  fi
}

# ------------------------------------------------------------------------------
# 4. Systemd Journal Vacuuming
# ------------------------------------------------------------------------------
clean_systemd_journal() {
  print_header "4. Vacuuming Systemd Journal Logs"
  
  log_info "Current journal disk usage:"
  journalctl --disk-usage

  log_info "Vacuuming journal logs older than 7 days (and capping at 100M)..."
  sudo journalctl --vacuum-time=7d --vacuum-size=100M || true
}

# ------------------------------------------------------------------------------
# 5. User Cache Cleanup
# ------------------------------------------------------------------------------
clean_user_caches() {
  print_header "5. Cleaning User & Developer Caches"

  # Thumbnail cache
  if [ -d "$HOME/.cache/thumbnails" ]; then
    log_info "Cleaning thumbnail cache..."
    rm -rf "$HOME/.cache/thumbnails"/*
    log_success "Thumbnail cache cleared."
  fi

  # Coredump cache
  if [ -d "/var/lib/systemd/coredump" ]; then
    log_info "Clearing system crash coredumps..."
    sudo rm -rf /var/lib/systemd/coredump/*
  fi

  # Debug info cache
  if [ -d "$HOME/.cache/debuginfod_client" ]; then
    log_info "Clearing debuginfod cache..."
    rm -rf "$HOME/.cache/debuginfod_client"/*
  fi

  # Node / NPM Cache
  if command -v npm &>/dev/null && [ -d "$HOME/.cache/npm" ]; then
    log_info "Cleaning npm cache..."
    npm cache clean --force 2>/dev/null || true
  fi

  # UV Cache
  if command -v uv &>/dev/null; then
    log_info "Pruning uv Python cache..."
    uv cache clean 2>/dev/null || true
  fi

  # Playwright Go / Temp caches if present
  if [ -d "$HOME/.cache/ms-playwright-go" ]; then
    log_info "Clearing ms-playwright-go cache..."
    rm -rf "$HOME/.cache/ms-playwright-go"/*
  fi
}

# ------------------------------------------------------------------------------
# 6. Broken Symlinks Scan in $HOME
# ------------------------------------------------------------------------------
check_broken_symlinks() {
  print_header "6. Scanning for Broken Symlinks in \$HOME"

  log_info "Scanning top-level dotfiles and directories..."
  local broken
  broken=$(find "$HOME" -maxdepth 3 -xtype l 2>/dev/null || true)

  if [ -n "$broken" ]; then
    log_warn "Found broken symlinks:"
    echo "$broken"
    read -rp "Do you want to delete these broken symlinks? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      find "$HOME" -maxdepth 3 -xtype l -delete 2>/dev/null || true
      log_success "Broken symlinks deleted."
    else
      log_info "Skipping symlink removal."
    fi
  else
    log_success "No broken symlinks found."
  fi
}

# ------------------------------------------------------------------------------
# 7. Optional Docker Cleanup (if running)
# ------------------------------------------------------------------------------
clean_docker() {
  if command -v docker &>/dev/null && systemctl is-active --quiet docker; then
    print_header "7. Docker Prune (Optional)"
    docker system df
    read -rp "Prune unused Docker containers, networks, and dangling images? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      docker system prune -f
      log_success "Docker system pruned."
    fi
  fi
}

# ------------------------------------------------------------------------------
# Main Execution
# ------------------------------------------------------------------------------
main() {
  printf "${BOLD}${GREEN}"
  printf "========================================================\n"
  printf "   Arch Linux System Maintenance & Cleanup Utility     \n"
  printf "========================================================\n"
  printf "${RESET}"

  local initial_free
  initial_free=$(disk_free_human)
  log_info "Initial free disk space on / : ${BOLD}${initial_free}${RESET}"

  check_sudo
  check_failed_services
  clean_package_cache
  remove_orphans
  clean_systemd_journal
  clean_user_caches
  check_broken_symlinks
  clean_docker

  local final_free
  final_free=$(disk_free_human)
  print_header "Cleanup Finished!"
  printf "Disk space on / before: ${BOLD}%s${RESET}\n" "$initial_free"
  printf "Disk space on / after:  ${BOLD}%s${RESET}\n" "$final_free"
  log_success "System is clean and maintained."
}

main "$@"
