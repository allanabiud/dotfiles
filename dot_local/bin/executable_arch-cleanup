#!/usr/bin/env bash
# ==============================================================================
# Arch Linux System Maintenance & Cleanup Utility
# Interactive, performant cleanup for minimal desktop setups.
# ==============================================================================

set -uo pipefail

# Color palette
BOLD=$(tput bold 2>/dev/null || printf "\033[1m")
GREEN=$(tput setaf 2 2>/dev/null || printf "\033[32m")
BLUE=$(tput setaf 4 2>/dev/null || printf "\033[34m")
YELLOW=$(tput setaf 3 2>/dev/null || printf "\033[33m")
RED=$(tput setaf 1 2>/dev/null || printf "\033[31m")
CYAN=$(tput setaf 6 2>/dev/null || printf "\033[36m")
RESET=$(tput sgr0 2>/dev/null || printf "\033[0m")

log_info()    { printf "%b==>%b %b%s%b\n" "$BLUE" "$RESET" "$BOLD" "$1" "$RESET"; }
log_success() { printf "%b==>%b %b%s%b\n" "$GREEN" "$RESET" "$BOLD" "$1" "$RESET"; }
log_warn()    { printf "%bWARNING:%b %s\n" "$YELLOW" "$RESET" "$1"; }
log_error()   { printf "%bERROR:%b %s\n" "$RED" "$RESET" "$1"; }

print_header() {
  printf "\n%b%s%b\n" "$BOLD" "$1" "$RESET"
  printf '%*s\n' "${#1}" '' | tr ' ' '='
}

ask_step() {
  local prompt="$1"
  local default="${2:-y}"
  printf "\n%b[?]%b %b%s%b " "$CYAN" "$RESET" "$BOLD" "$prompt" "$RESET"
  if [[ "$default" =~ ^[Yy]$ ]]; then
    printf "[Y/n]: "
  else
    printf "[y/N]: "
  fi
  read -r reply
  reply="${reply:-$default}"
  [[ "$reply" =~ ^[Yy]$ ]]
}

show_disk_usage() {
  printf "  %b%-12s %-10s %-10s %-10s %-6s%b\n" "$BOLD" "Mount" "Size" "Used" "Avail" "Use%" "$RESET"
  df -h / /home 2>/dev/null | awk 'NR>1 {printf "  %-12s %-10s %-10s %-10s %-6s\n", $6, $2, $3, $4, $5}'
}

# ------------------------------------------------------------------------------
# 1. Systemd Service Diagnostics (Read-Only)
# ------------------------------------------------------------------------------
check_failed_services() {
  print_header "1. Checking Systemd Services"

  local failed_sys failed_user
  failed_sys=$(systemctl --failed --quiet --lines=0 2>/dev/null || true)
  failed_user=$(systemctl --user --failed --quiet --lines=0 2>/dev/null || true)

  if [ -z "$failed_sys" ] && [ -z "$failed_user" ]; then
    log_success "No failed system or user services found."
  else
    if [ -n "$failed_sys" ]; then
      log_warn "Failed system services found:"
      systemctl --failed --lines=0
    fi
    if [ -n "$failed_user" ]; then
      log_warn "Failed user services found:"
      systemctl --user --failed --lines=0
    fi
  fi
}

# ------------------------------------------------------------------------------
# 2. Package Cache Cleanup
# ------------------------------------------------------------------------------
clean_package_cache() {
  print_header "2. Package Cache Cleanup"

  if ! ask_step "Clean pacman and AUR build caches?"; then
    log_info "Skipping package cache cleanup."
    return 0
  fi

  if command -v paccache &>/dev/null; then
    log_info "Keeping 2 most recent installed package versions..."
    sudo paccache -rk2 || true

    log_info "Removing all uninstalled packages from cache..."
    sudo paccache -ruk0 || true
  else
    log_info "Cleaning pacman cache..."
    sudo pacman -Sc --noconfirm || true
  fi

  # Clean yay AUR build cache specifically without touching pacman pkg dir again
  if [ -d "$HOME/.cache/yay" ]; then
    log_info "Cleaning yay build directory (~/.cache/yay)..."
    if command -v yay &>/dev/null; then
      yay -Sc --aur --noconfirm || true
    else
      rm -rf "$HOME/.cache/yay"/*
    fi
    log_success "AUR cache cleaned."
  fi
}

# ------------------------------------------------------------------------------
# 3. Orphan Package Removal
# ------------------------------------------------------------------------------
remove_orphans() {
  print_header "3. Orphan Package Removal"

  local orphans
  orphans=$(pacman -Qtdq 2>/dev/null || true)

  if [ -z "$orphans" ]; then
    log_success "No orphaned packages found on your system."
    return 0
  fi

  echo "The following unused packages (orphans) were detected:"
  echo "$orphans" | column -c 80 2>/dev/null || echo "$orphans"

  if ask_step "Remove these orphaned packages?" "n"; then
    sudo pacman -Rns $orphans
    log_success "Orphaned packages removed."
  else
    log_info "Skipping orphan removal."
  fi
}

# ------------------------------------------------------------------------------
# 4. Systemd Journal Vacuuming
# ------------------------------------------------------------------------------
clean_systemd_journal() {
  print_header "4. Systemd Journal Logs"

  log_info "Current journal disk usage:"
  journalctl --disk-usage 2>/dev/null || true

  if ! ask_step "Vacuum journal logs (retain last 7 days, max 100M)?"; then
    log_info "Skipping journal vacuuming."
    return 0
  fi

  log_info "Vacuuming journal logs..."
  sudo journalctl --vacuum-time=7d --vacuum-size=100M || true
  log_success "Journal vacuumed."
}

# ------------------------------------------------------------------------------
# 5. User & Developer Caches
# ------------------------------------------------------------------------------
clean_user_caches() {
  print_header "5. User & Developer Caches"

  local user_cache_items=()
  [ -d "$HOME/.cache/thumbnails" ] && user_cache_items+=("Thumbnails (~/.cache/thumbnails)")
  [ -d "/var/lib/systemd/coredump" ] && user_cache_items+=("Core dumps (/var/lib/systemd/coredump)")
  [ -d "$HOME/.cache/debuginfod_client" ] && user_cache_items+=("Debug info (~/.cache/debuginfod_client)")
  [ -d "$HOME/.cache/npm" ] && user_cache_items+=("Node/npm cache (~/.cache/npm)")
  [ -d "$HOME/.cache/uv" ] && user_cache_items+=("UV Python cache (~/.cache/uv)")
  [ -d "$HOME/.cache/ms-playwright-go" ] && user_cache_items+=("Playwright cache (~/.cache/ms-playwright-go)")

  if [ ${#user_cache_items[@]} -gt 0 ]; then
    echo "Detected cached data in:"
    for item in "${user_cache_items[@]}"; do
      echo "  - $item"
    done
  fi

  if ! ask_step "Clean user application and developer caches?"; then
    log_info "Skipping user cache cleanup."
    return 0
  fi

  # Thumbnails
  if [ -d "$HOME/.cache/thumbnails" ]; then
    rm -rf "$HOME/.cache/thumbnails"/*
    log_success "Thumbnails cleared."
  fi

  # Crash core dumps
  if [ -d "/var/lib/systemd/coredump" ]; then
    sudo rm -rf /var/lib/systemd/coredump/*
    log_success "Core dumps cleared."
  fi

  # Debuginfod
  if [ -d "$HOME/.cache/debuginfod_client" ]; then
    rm -rf "$HOME/.cache/debuginfod_client"/*
    log_success "Debuginfod cache cleared."
  fi

  # NPM
  if command -v npm &>/dev/null && [ -d "$HOME/.cache/npm" ]; then
    npm cache clean --force 2>/dev/null || rm -rf "$HOME/.cache/npm"/*
    log_success "NPM cache cleaned."
  fi

  # UV
  if command -v uv &>/dev/null; then
    uv cache clean 2>/dev/null || true
    log_success "UV cache cleaned."
  fi

  # Playwright Go
  if [ -d "$HOME/.cache/ms-playwright-go" ]; then
    rm -rf "$HOME/.cache/ms-playwright-go"/*
    log_success "Playwright cache cleared."
  fi
}

# ------------------------------------------------------------------------------
# 6. Broken Symlinks Scan in $HOME
# ------------------------------------------------------------------------------
check_broken_symlinks() {
  print_header "6. Broken Symlinks in \$HOME"

  if ! ask_step "Scan for broken symlinks in \$HOME?"; then
    log_info "Skipping symlink scan."
    return 0
  fi

  log_info "Scanning for broken links (ignoring live browser session locks)..."
  local broken
  # Filter out browser Singleton lockfiles which are active runtime locks
  broken=$(find "$HOME" -maxdepth 3 -xtype l -not -name "*Singleton*" 2>/dev/null || true)

  if [ -n "$broken" ]; then
    log_warn "Found broken symlinks:"
    echo "$broken"
    if ask_step "Delete these broken symlinks?" "n"; then
      find "$HOME" -maxdepth 3 -xtype l -not -name "*Singleton*" -delete 2>/dev/null || true
      log_success "Broken symlinks deleted."
    else
      log_info "Skipped deleting symlinks."
    fi
  else
    log_success "No broken symlinks found."
  fi
}

# ------------------------------------------------------------------------------
# 7. Optional Docker Cleanup
# ------------------------------------------------------------------------------
clean_docker() {
  if command -v docker &>/dev/null && systemctl is-active --quiet docker; then
    print_header "7. Docker Maintenance"
    docker system df

    if ask_step "Prune unused Docker containers, networks, and dangling images?" "n"; then
      docker system prune -f
      log_success "Docker system pruned."
    else
      log_info "Skipping Docker prune."
    fi
  fi
}

# ------------------------------------------------------------------------------
# Main
# ------------------------------------------------------------------------------
main() {
  printf "%b" "$BOLD$GREEN"
  printf "========================================================\n"
  printf "   Arch Linux System Maintenance & Cleanup Utility     \n"
  printf "========================================================\n"
  printf "%b" "$RESET"

  printf "\n%bInitial Disk Usage:%b\n" "$BOLD" "$RESET"
  show_disk_usage

  check_failed_services
  clean_package_cache
  remove_orphans
  clean_systemd_journal
  clean_user_caches
  check_broken_symlinks
  clean_docker

  print_header "Cleanup Finished!"
  printf "\n%bFinal Disk Usage:%b\n" "$BOLD" "$RESET"
  show_disk_usage
  log_success "Maintenance complete."
}

main "$@"
