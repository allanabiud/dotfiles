#!/usr/bin/env python3
"""
comic_to_webp.py - High-Performance Batch WebP Comic Converter

Features:
- Processes single files, multiple files, or entire directories recursively.
- Fast archive inspection: skips archives that are already 100% WebP without extracting.
- Multiprocess parallel page conversion using cwebp / Pillow.
- Preserves all metadata (ComicInfo.xml, MetronInfo.xml, etc.).
- Strips OS clutter (.DS_Store, Thumbs.db, __MACOSX).
- Atomic replacement and integrity testing.
- Rich terminal UI with progress bars and conversion statistics.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
import time
from typing import Dict, List, Optional, Set, Tuple

try:
    from rich.console import Console
    from rich.progress import (
        BarColumn,
        MofNCompleteColumn,
        Progress,
        SpinnerColumn,
        TaskProgressColumn,
        TextColumn,
        TimeElapsedColumn,
    )
    from rich.table import Table

    HAS_RICH = True
    console = Console()
except ImportError:
    HAS_RICH = False
    console = None

try:
    from PIL import Image
    HAS_PILLOW = True
except ImportError:
    HAS_PILLOW = False

IMAGE_EXTENSIONS: Set[str] = {".jpg", ".jpeg", ".png", ".gif", ".bmp", ".jxl", ".tiff", ".webp"}
CONVERTIBLE_EXTENSIONS: Set[str] = {".jpg", ".jpeg", ".png", ".gif", ".bmp", ".jxl", ".tiff"}
COMIC_EXTENSIONS: Set[str] = {".cbz", ".cbr", ".cb7", ".cbt", ".zip", ".rar", ".7z"}
JUNK_FILES: Set[str] = {"thumbs.db", ".ds_store", "desktop.ini"}
JUNK_DIRS: Set[str] = {"__macosx"}


def human_size(bytes_val: int) -> str:
    """Format bytes into human-readable string."""
    for unit in ["B", "KB", "MB", "GB"]:
        if abs(bytes_val) < 1024.0:
            return f"{bytes_val:3.1f} {unit}"
        bytes_val /= 1024.0
    return f"{bytes_val:.1f} TB"


def print_msg(msg: str, style: str = "white") -> None:
    if HAS_RICH and console:
        console.print(f"[{style}]{msg}[/{style}]")
    else:
        print(msg)


def inspect_archive(archive_path: pathlib.Path) -> Tuple[Dict[str, int], int]:
    """
    Fast pre-inspection of archive contents using 7z without extracting files.
    Returns (extension_counts, total_files).
    """
    ext_counts: Dict[str, int] = {}
    total_files = 0

    try:
        res = subprocess.run(
            ["7z", "l", "-slt", str(archive_path)],
            capture_output=True,
            text=True,
            check=True,
        )
    except Exception as e:
        print_msg(f"Error inspecting {archive_path.name}: {e}", "red")
        return {}, 0

    for line in res.stdout.splitlines():
        if line.startswith("Path = ") and not line.endswith(str(archive_path)):
            entry_path = line[7:].strip()
            # Skip directory entries
            ext = pathlib.Path(entry_path).suffix.lower()
            if ext:
                ext_counts[ext] = ext_counts.get(ext, 0) + 1
                total_files += 1

    return ext_counts, total_files


def is_already_webp(archive_path: pathlib.Path, ext_counts: Dict[str, int]) -> bool:
    """Check if the comic is a CBZ and all images are already WebP."""
    if archive_path.suffix.lower() != ".cbz":
        return False

    image_exts = {ext for ext in ext_counts if ext in IMAGE_EXTENSIONS}
    if not image_exts:
        return False

    # If only .webp is present among image formats
    return image_exts == {".webp"}


def convert_image(src_file: pathlib.Path, dst_file: pathlib.Path, quality: int, lossless: bool) -> bool:
    """Convert a single image to WebP using cwebp, falling back to Pillow."""
    dst_file.parent.mkdir(parents=True, exist_ok=True)

    # 1. Try cwebp CLI
    cmd = ["cwebp", "-quiet", "-m", "6", "-mt"]
    if lossless:
        cmd.append("-lossless")
    else:
        cmd.extend(["-q", str(quality)])
    cmd.extend([str(src_file.resolve()), "-o", str(dst_file.resolve())])

    try:
        res = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode == 0 and dst_file.exists() and dst_file.stat().st_size > 0:
            src_file.unlink(missing_ok=True)
            return True
    except FileNotFoundError:
        pass

    # 2. Fallback to Pillow
    if HAS_PILLOW:
        try:
            with Image.open(src_file) as im:
                # Convert RGBA/RGB modes if necessary
                if im.mode in ("P", "1"):
                    im = im.convert("RGBA" if "transparency" in im.info else "RGB")
                elif im.mode not in ("RGB", "RGBA"):
                    im = im.convert("RGB")
                im.save(dst_file, "WEBP", quality=quality, lossless=lossless, method=6)
            if dst_file.exists() and dst_file.stat().st_size > 0:
                src_file.unlink(missing_ok=True)
                return True
        except Exception:
            pass

    return False


def clean_clutter(root_path: pathlib.Path) -> None:
    """Remove OS metadata and scrap junk files."""
    for root, dirs, files in os.walk(root_path, topdown=False):
        for f in files:
            if f.lower() in JUNK_FILES or f.startswith("._"):
                (pathlib.Path(root) / f).unlink(missing_ok=True)
        for d in dirs:
            if d.lower() in JUNK_DIRS:
                shutil.rmtree(pathlib.Path(root) / d, ignore_errors=True)


def convert_archive(
    archive_path: pathlib.Path,
    quality: int = 80,
    lossless: bool = False,
    jobs: int = 4,
    dry_run: bool = False,
) -> Tuple[str, int, int]:
    """
    Converts a comic archive to WebP CBZ.
    Returns (status, original_bytes, new_bytes).
    status can be: 'SKIPPED', 'CONVERTED', 'FAILED', 'DRY_RUN'
    """
    orig_size = archive_path.stat().st_size

    # Fast inspection
    ext_counts, _ = inspect_archive(archive_path)
    if not ext_counts:
        return "FAILED", orig_size, orig_size

    if is_already_webp(archive_path, ext_counts):
        return "SKIPPED", orig_size, orig_size

    if dry_run:
        return "DRY_RUN", orig_size, orig_size

    with tempfile.TemporaryDirectory(prefix="comic_webp_") as tmp_dir:
        extract_dir = pathlib.Path(tmp_dir) / "extracted"
        extract_dir.mkdir(parents=True, exist_ok=True)

        # 1. Extract archive preserving subpaths
        try:
            subprocess.run(
                ["7z", "x", f"-o{extract_dir.resolve()}", "-y", str(archive_path.resolve())],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True,
            )
        except subprocess.CalledProcessError:
            print_msg(f"Failed to extract {archive_path.name}", "red")
            return "FAILED", orig_size, orig_size

        # 2. Clean OS clutter
        clean_clutter(extract_dir)

        # 3. Find images needing conversion
        tasks: List[Tuple[pathlib.Path, pathlib.Path]] = []
        for root, _, files in os.walk(extract_dir):
            for file_name in files:
                file_path = pathlib.Path(root) / file_name
                ext = file_path.suffix.lower()
                if ext in CONVERTIBLE_EXTENSIONS:
                    target_webp = file_path.with_suffix(".webp")
                    tasks.append((file_path, target_webp))

        # 4. Multi-threaded page conversion
        if tasks:
            with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as executor:
                futures = [
                    executor.submit(convert_image, src, dst, quality, lossless)
                    for src, dst in tasks
                ]
                concurrent.futures.wait(futures)

        # Ensure no lingering original image files remain
        for root, _, files in os.walk(extract_dir):
            for file_name in files:
                file_path = pathlib.Path(root) / file_name
                if file_path.suffix.lower() in CONVERTIBLE_EXTENSIONS:
                    file_path.unlink(missing_ok=True)

        # 5. Pack into temporary CBZ
        temp_cbz = pathlib.Path(tmp_dir) / f"packed_{archive_path.stem}.cbz"
        cmd = [
            "7z",
            "a",
            "-tzip",
            "-mx=9",
            str(temp_cbz.resolve()),
            ".",
        ]
        try:
            subprocess.run(
                cmd,
                cwd=str(extract_dir.resolve()),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True,
            )
        except subprocess.CalledProcessError:
            print_msg(f"Failed to pack CBZ for {archive_path.name}", "red")
            return "FAILED", orig_size, orig_size

        # 6. Verify integrity of new archive
        try:
            subprocess.run(
                ["7z", "t", str(temp_cbz.resolve())],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=True,
            )
        except subprocess.CalledProcessError:
            print_msg(f"Integrity check failed for {archive_path.name}", "red")
            return "FAILED", orig_size, orig_size

        # 7. Replace destination file
        final_cbz = archive_path.with_suffix(".cbz")
        new_size = temp_cbz.stat().st_size

        # If converting from .cbr/.cb7, delete original
        if archive_path.resolve() != final_cbz.resolve() and archive_path.exists():
            archive_path.unlink(missing_ok=True)

        shutil.move(str(temp_cbz), str(final_cbz))
        return "CONVERTED", orig_size, new_size


def collect_targets(paths: List[str], recursive: bool = True) -> List[pathlib.Path]:
    """Collect all comic archive paths from files and directories."""
    collected: List[pathlib.Path] = []
    seen: Set[pathlib.Path] = set()

    for p_str in paths:
        p = pathlib.Path(p_str).expanduser().resolve()
        if not p.exists():
            print_msg(f"Warning: path does not exist: {p}", "yellow")
            continue

        if p.is_file():
            if p.suffix.lower() in COMIC_EXTENSIONS and p not in seen:
                collected.append(p)
                seen.add(p)
        elif p.is_dir():
            pattern = "**/*" if recursive else "*"
            for item in p.glob(pattern):
                if item.is_file() and item.suffix.lower() in COMIC_EXTENSIONS and item not in seen:
                    collected.append(item)
                    seen.add(item)

    collected.sort()
    return collected


def main() -> int:
    parser = argparse.ArgumentParser(
        description="High-Performance Batch WebP Comic Converter.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument(
        "targets",
        nargs="+",
        help="One or more comic archive files or directories.",
    )
    parser.add_argument(
        "-q",
        "--quality",
        type=int,
        default=80,
        help="WebP compression quality (0-100).",
    )
    parser.add_argument(
        "-j",
        "--jobs",
        type=int,
        default=min(os.cpu_count() or 4, 8),
        help="Number of parallel worker threads per comic.",
    )
    parser.add_argument(
        "--lossless",
        action="store_true",
        help="Use lossless WebP compression.",
    )
    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="Force re-conversion even if archive is already WebP.",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="Scan archives and display what would be converted without modifying files.",
    )
    parser.add_argument(
        "--no-recursive",
        action="store_true",
        help="Do not scan directories recursively.",
    )

    args = parser.parse_args()

    targets = collect_targets(args.targets, recursive=not args.no_recursive)
    if not targets:
        print_msg("No comic archives found.", "red")
        return 1

    print_msg(
        f"\n[bold cyan]Found {len(targets)} comic archive(s) to inspect.[/bold cyan] (Quality: {args.quality}, Jobs: {args.jobs})\n"
    )

    stats = {
        "SKIPPED": 0,
        "CONVERTED": 0,
        "FAILED": 0,
        "DRY_RUN": 0,
        "orig_bytes": 0,
        "new_bytes": 0,
    }

    start_time = time.time()

    if HAS_RICH and console:
        table = Table(title="Comic Conversion Results", header_style="bold magenta")
        table.add_column("Archive", style="dim", overflow="fold")
        table.add_column("Status", justify="center")
        table.add_column("Original", justify="right")
        table.add_column("New Size", justify="right")
        table.add_column("Reduction", justify="right")

        with Progress(
            SpinnerColumn(),
            TextColumn("[progress.description]{task.description}"),
            BarColumn(),
            TaskProgressColumn(),
            MofNCompleteColumn(),
            TimeElapsedColumn(),
            console=console,
            transient=True,
        ) as progress:
            task = progress.add_task("Processing comics...", total=len(targets))
            for item in targets:
                progress.update(task, description=f"Processing [cyan]{item.name[:40]}[/cyan]")
                status, orig_b, new_b = convert_archive(
                    item,
                    quality=args.quality,
                    lossless=args.lossless,
                    jobs=args.jobs,
                    dry_run=args.dry_run,
                )

                stats[status] = stats.get(status, 0) + 1
                stats["orig_bytes"] += orig_b
                stats["new_bytes"] += new_b

                if status == "SKIPPED":
                    table.add_row(item.name, "[green]Already WebP[/green]", human_size(orig_b), "-", "-")
                elif status == "CONVERTED":
                    saved = orig_b - new_b
                    pct = (saved / orig_b * 100) if orig_b > 0 else 0
                    table.add_row(
                        item.name,
                        "[bold green]Converted[/bold green]",
                        human_size(orig_b),
                        human_size(new_b),
                        f"[cyan]-{pct:.1f}%[/cyan]",
                    )
                elif status == "DRY_RUN":
                    table.add_row(item.name, "[yellow]Needs Conversion[/yellow]", human_size(orig_b), "-", "-")
                else:
                    table.add_row(item.name, "[bold red]Failed[/bold red]", human_size(orig_b), "-", "-")

                progress.advance(task)

        console.print(table)
    else:
        for idx, item in enumerate(targets, 1):
            print(f"[{idx}/{len(targets)}] {item.name} ... ", end="", flush=True)
            status, orig_b, new_b = convert_archive(
                item,
                quality=args.quality,
                lossless=args.lossless,
                jobs=args.jobs,
                dry_run=args.dry_run,
            )
            stats[status] = stats.get(status, 0) + 1
            stats["orig_bytes"] += orig_b
            stats["new_bytes"] += new_b

            if status == "SKIPPED":
                print("Already 100% WebP (Skipped)")
            elif status == "CONVERTED":
                pct = ((orig_b - new_b) / orig_b * 100) if orig_b > 0 else 0
                print(f"Converted ({human_size(orig_b)} -> {human_size(new_b)}, -{pct:.1f}%)")
            elif status == "DRY_RUN":
                print("Needs Conversion (Dry Run)")
            else:
                print("FAILED")

    elapsed = time.time() - start_time
    total_saved = stats["orig_bytes"] - stats["new_bytes"]
    overall_pct = (total_saved / stats["orig_bytes"] * 100) if stats["orig_bytes"] > 0 else 0

    print_msg("\n[bold]Summary:[/bold]")
    print_msg(f"  Total Inspected: {len(targets)}")
    print_msg(f"  Converted:       {stats['CONVERTED']}", "green")
    print_msg(f"  Already WebP:    {stats['SKIPPED']}", "dim")
    if stats["FAILED"] > 0:
        print_msg(f"  Failed:          {stats['FAILED']}", "red")
    if stats["CONVERTED"] > 0:
        print_msg(
            f"  Space Saved:     [bold green]{human_size(total_saved)}[/bold green] (-{overall_pct:.1f}%)"
        )
    print_msg(f"  Elapsed Time:    {elapsed:.1f}s\n")

    return 0


if __name__ == "__main__":
    sys.exit(main())
